MYSQL_DATABASE=plataforma
MYSQL_USER=plataforma_app
MYSQL_PASSWORD=replace-with-a-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3306

JWT_ISSUER=plataforma-auth
JWT_AUDIENCE=plataforma-games
JWT_SIGNING_KEY_BASE64=generate-a-random-32-byte-base64-key

# Optional: configure SMTP to enable password reset emails.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Plataforma
PASSWORD_RESET_PUBLIC_URL=

# Test mode grants Dash & Crash to every authenticated account; keep disabled in production.
GAME_DELIVERY_SANDBOX_TEST_MODE_ENABLED=false
BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net
BUNNY_CDN_TOKEN_AUTH_KEY=
GAME_DELIVERY_TOKEN_LIFETIME_SECONDS=600
PLATFORM_LAUNCHER_WINDOWS_OBJECT_PATH=
PLATFORM_LAUNCHER_MACOS_X64_OBJECT_PATH=
PLATFORM_LAUNCHER_MACOS_ARM64_OBJECT_PATH=
PLATFORM_LAUNCHER_LINUX_X64_OBJECT_PATH=
PLATFORM_LAUNCHER_UPDATES_DIRECTORY_PATH=
GAME_DELIVERY_LAUNCHER_UPDATE_TOKEN_LIFETIME_SECONDS=3600
DASH_AND_CRASH_WINDOWS_OBJECT_PATH=
DASH_AND_CRASH_WEBGL_DIRECTORY_PATH=
DASH_AND_CRASH_WEBGL_ENTRY_POINT=index.html

AUTH_API_PORT=5000
MATCHMAKING_API_PORT=5001
GAME_SERVER_UDP_PORT=9050
GAME_SERVER_PUBLIC_ADDRESS=127.0.0.1
MASSIVE_GAME_CODE=arena-massive
MASSIVE_MIN_PLAYERS=1
MASSIVE_MAX_PLAYERS=50
MASSIVE_MATCH_START_DELAY_SECONDS=0
COOP_MATCHMAKING_API_PORT=5002
COOP_GAME_SERVER_UDP_PORT=9051
COOP_GAME_SERVER_PUBLIC_ADDRESS=127.0.0.1
COOP_GAME_CODE=arena-coop
COOP_MIN_PLAYERS=1
COOP_MAX_PLAYERS=4
COOP_MATCH_START_DELAY_SECONDS=2
COOP_QUEUE_TIMEOUT_SECONDS=60
COOP_TICKET_LIFETIME_SECONDS=120
WEB_PORT=3000
MATCHMAKING_QUEUE_TIMEOUT_SECONDS=60
MATCHMAKING_TICKET_LIFETIME_SECONDS=120
GAME_AUTH_TIMEOUT_SECONDS=5
