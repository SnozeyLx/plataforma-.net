MYSQL_DATABASE=plataforma
MYSQL_USER=plataforma_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=13306

JWT_ISSUER=plataforma-auth
JWT_AUDIENCE=plataforma-games
JWT_SIGNING_KEY_BASE64=

# Configure these with the SMTP credentials from your email provider.
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Plataforma
PASSWORD_RESET_PUBLIC_URL=https://plataforma.crefeed.com.br/redefinir-senha

# Keep test ownership grants disabled in every production environment.
GAME_DELIVERY_SANDBOX_TEST_MODE_ENABLED=false
BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net
BUNNY_CDN_TOKEN_AUTH_KEY=
GAME_DELIVERY_TOKEN_LIFETIME_SECONDS=600
PLATFORM_LAUNCHER_WINDOWS_OBJECT_PATH=Plataform-Build/Plataforma_laucher.exe
PLATFORM_LAUNCHER_MACOS_X64_OBJECT_PATH=Plataform-Build/Plataforma_laucher_macos_x64.pkg
PLATFORM_LAUNCHER_MACOS_ARM64_OBJECT_PATH=Plataform-Build/Plataforma_laucher_macos_arm64.pkg
PLATFORM_LAUNCHER_LINUX_X64_OBJECT_PATH=Plataform-Build/Plataforma_laucher_linux_x64.AppImage
PLATFORM_LAUNCHER_UPDATES_DIRECTORY_PATH=Plataform-Build/updates
GAME_DELIVERY_LAUNCHER_UPDATE_TOKEN_LIFETIME_SECONDS=3600
DASH_AND_CRASH_WINDOWS_OBJECT_PATH=
DASH_AND_CRASH_WEBGL_DIRECTORY_PATH=
DASH_AND_CRASH_WEBGL_ENTRY_POINT=index.html

AUTH_API_PORT=15000
MATCHMAKING_API_PORT=15001
COOP_MATCHMAKING_API_PORT=15002

GAME_SERVER_PUBLIC_ADDRESS=massive.example.com
GAME_SERVER_UDP_PORT=9050
COOP_GAME_SERVER_PUBLIC_ADDRESS=coop.example.com
COOP_GAME_SERVER_UDP_PORT=9051

# Keep loopback until the provider firewall allowlists the test clients.
GAME_SERVER_UDP_BIND_ADDRESS=127.0.0.1
GAME_SERVER_LOG_LEVEL=Information
