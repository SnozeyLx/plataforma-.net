@baseUrl = http://localhost:5000
@accessToken = replace-with-a-valid-access-token

### Get the authenticated player's library
GET {{baseUrl}}/api/library
Authorization: Bearer {{accessToken}}

### Get a temporary Windows download URL for an owned game
GET {{baseUrl}}/api/games/dash-and-crash/access?platform=windows
Authorization: Bearer {{accessToken}}

### Get a temporary WebGL URL for an owned game
GET {{baseUrl}}/api/games/dash-and-crash/access?platform=webgl
Authorization: Bearer {{accessToken}}

### Get a temporary download URL for the Windows x64 launcher
GET {{baseUrl}}/api/launcher/windows/access

### Get a temporary download URL for the Intel macOS launcher
GET {{baseUrl}}/api/launcher/macos-x64/access

### Get a temporary download URL for the Apple Silicon macOS launcher
GET {{baseUrl}}/api/launcher/macos-arm64/access

### Get a temporary download URL for the Linux x64 launcher
GET {{baseUrl}}/api/launcher/linux-x64/access

### Redirect to a Velopack update feed asset
GET {{baseUrl}}/api/launcher/updates/win-x64/releases.win-x64.json

### Verify an unsupported platform is rejected
GET {{baseUrl}}/api/games/dash-and-crash/access?platform=android
Authorization: Bearer {{accessToken}}
