@baseUrl = http://localhost:5000
@email = usuario@example.com
@resetToken = substitua-pelo-token-do-link

### Request a reset link (response remains generic for unknown emails)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{email}}"
}

### Reset the password using the token from the email
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "{{email}}",
  "token": "{{resetToken}}",
  "newPassword": "NovaSenhaDeTeste123"
}

### Invalid or expired tokens return 400
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "{{email}}",
  "token": "token-invalido",
  "newPassword": "NovaSenhaDeTeste123"
}
